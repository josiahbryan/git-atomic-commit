{
  "name": "git-atomic-commit",
  "version": "1.0.0",
  "description": "Atomic git stage+commit with repo-wide locking for multi-agent safety",
  "license": "MIT",
  "author": "Josiah Bryan <josiahbryan@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/josiahbryan/git-atomic-commit.git"
  },
  "keywords": [
    "git",
    "atomic",
    "commit",
    "lock",
    "multi-agent",
    "concurrency",
    "monorepo",
    "ai-agent",
    "cli"
  ],
  "scripts": {
    "build": "bun build --compile --outfile dist/git-atomic-commit src/cli.ts",
    "test": "bun test",
    "setup": "bun run build && bash scripts/install.sh",
    "uninstall": "bash scripts/uninstall.sh",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "commander": "^12.0.0"
  }
}
